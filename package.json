{
  "name": "pos",
  "productName": "POS",
  "version": "0.1.0",
  "private": true,
  "description": "Personal Operating System — relationships, calendar engine, messaging (local-first macOS app)",
  "main": "dist-main/main.cjs",
  "author": "Aamir Tinwala",
  "scripts": {
    "build:main": "esbuild main/index.ts --bundle --platform=node --format=cjs --external:electron --external:better-sqlite3 --external:sqlite-vec --outfile=dist-main/main.cjs",
    "build:preload": "esbuild preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-main/preload.cjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "rebuild:node": "npm rebuild better-sqlite3",
    "rebuild:electron": "cd node_modules/better-sqlite3 && npx prebuild-install -r electron -t 33.4.11",
    "dev": "npm run rebuild:electron && npm run build:main && npm run build:preload && VITE_DEV=1 concurrently -k \"vite\" \"electron .\"",
    "start": "npm run rebuild:electron && npm run build && electron .",
    "test": "vitest run",
    "migrate:from-postgres": "tsx scripts/migrate-from-postgres.ts",
    "package": "npm run build && electron-builder --mac --arm64"
  },
  "dependencies": {
    "@google/genai": "^2.7.0",
    "better-sqlite3": "^11.10.0",
    "csv-parse": "^6.2.1",
    "googleapis": "^144.0.0",
    "imapflow": "^1.3.7",
    "js-yaml": "^4.1.0",
    "mailparser": "^3.9.9",
    "node-cron": "^3.0.3",
    "nodemailer": "^9.0.4",
    "sqlite-vec": "^0.1.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/js-yaml": "^4.0.9",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.3.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
